APP_NAME=ShopMate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Database: MySQL (Laragon/XAMPP locally, Amazon RDS in production)
# ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopmate
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Searches run as background jobs. Run "php artisan queue:work" alongside the site,
# or set QUEUE_CONNECTION=sync to run them inside the request (simpler, slower page).
QUEUE_CONNECTION=database

CACHE_STORE=database

# Emails (price alerts) are written to storage/logs/laravel.log until you set real SMTP details.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="alerts@shopmate.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# ShopMate
# ---------------------------------------------------------------
# Leave GROQ_API_KEY empty to use the built-in offline (rule-based) AI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_TO_OFFLINE=true

# Secret used to sign cart approvals (HMAC-SHA256). Falls back to APP_KEY if empty.
MANDATE_SECRET=

# Password for /admin (SEO editor and operations view). Empty = admin switched off.
ADMIN_PASSWORD=

# Proxies allowed to set X-Forwarded-For (comma-separated IPs/CIDR). Leave empty when
# Nginx talks to PHP-FPM directly (EC2). Behind a load balancer, set its range.
TRUSTED_PROXIES=

# Live demo only: let the scheduler move fictional demo prices so charts show history.
DEMO_SIMULATE_PRICES=false

# AWS (used for S3 backups by scripts/backup.sh)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
